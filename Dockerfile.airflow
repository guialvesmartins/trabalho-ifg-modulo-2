# Imagem do Airflow com as dependencias do pipeline (audio, ML, dbt)
# baked in — evita pip install a cada boot do container via
# _PIP_ADDITIONAL_REQUIREMENTS (lento e fragil a falhas de rede).
FROM apache/airflow:2.9.0

USER root
# gcc + libpq-dev: necessarios para compilar o psycopg2 (dependencia do dbt-postgres)
# libsndfile1: backend de leitura de audio do soundfile/librosa
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

USER airflow
# Camadas separadas: uma falha de rede nao perde o progresso das anteriores
RUN pip install --no-cache-dir --retries 10 --timeout 60 scikit-learn matplotlib
RUN pip install --no-cache-dir --retries 10 --timeout 60 librosa soundfile tqdm python-dotenv
RUN pip install --no-cache-dir --retries 10 --timeout 60 dbt-core==1.8.0 dbt-postgres==1.8.0
